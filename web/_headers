# Cloudflare Pages static assets; API requests are handled separately.
/tiles/*
  Cache-Control: public, max-age=604800, immutable

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

/avatar.png
  Cache-Control: public, max-age=604800
